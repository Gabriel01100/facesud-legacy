# Valores exclusivamente para desarrollo local. No usar en producción.
APP_ENV=development
POSTGRES_PASSWORD=facesud_dev
REDIS_PASSWORD=facesud_dev

# Correo local: Mailpit captura los mensajes y no los entrega a destinatarios reales.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=FaceSud <no-reply@facesud.local>
FRONTEND_BASE_URL=http://localhost:5173

# Correos de cuentas autorizadas a administrar unidades y revisar solicitudes (separados por coma).
COMMUNITY_REVIEWER_EMAILS=

# Imágenes privadas de publicaciones. En local se guardan en el volumen Docker media_data.
MEDIA_STORAGE_BACKEND=local
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_MAX_IMAGE_PIXELS=20000000
MEDIA_MAX_POST_IMAGES=4

# Producción: bucket S3 privado, sin acceso público. Nunca guardar estas credenciales en el repositorio.
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_S3_BUCKET=facesud-private-media
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT_URL=https://s3.example.com
# MEDIA_S3_ACCESS_KEY_ID=REEMPLAZAR
# MEDIA_S3_SECRET_ACCESS_KEY=REEMPLAZAR

# Producción: proveedor SMTP transaccional (por ejemplo Resend).
# Requiere dominio emisor verificado y credenciales SMTP reales.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=REEMPLAZAR_POR_API_KEY
# SMTP_STARTTLS=true
# EMAIL_FROM=FaceSud <no-reply@TU-DOMINIO>
# FRONTEND_BASE_URL=https://TU-DOMINIO
# CORS_ORIGINS=https://TU-DOMINIO
# REDIS_URL=redis://:PASSWORD@redis.internal:6379/0
