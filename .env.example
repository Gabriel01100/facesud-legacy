# Valores exclusivamente para desarrollo local. No usar en producción.
APP_ENV=development
POSTGRES_PASSWORD=facesud_dev
REDIS_PASSWORD=facesud_dev

# SMTP transaccional (STARTTLS). Dejar sin configurar deshabilita el registro.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
FRONTEND_BASE_URL=http://localhost:5173

# En producción, definir REDIS_URL con contraseña URL-encoded y credenciales seguras.
# REDIS_URL=redis://:PASSWORD@redis.internal:6379/0
# CORS_ORIGINS=https://facesud.example.org
